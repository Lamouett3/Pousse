# ---- Base de données ----
# Mot de passe de PostgreSQL (docker compose) — à générer : openssl rand -base64 32
POSTGRES_PASSWORD=
# Connexion utilisée par l'API (hors docker compose)
DATABASE_URL=postgres://pousse:MOT_DE_PASSE@localhost:5432/pousse

# ---- API ----
PORT=3000
# Cookie « Secure » : true en production (HTTPS). false uniquement en local sans HTTPS.
COOKIE_SECURE=true
# Durée d'une session inactive avant reconnexion (jours)
SESSION_DAYS=30
# Tentatives de connexion / inscription par minute et par adresse IP
AUTH_MAX_PER_MINUTE=10
# À renseigner seulement si l'application est servie depuis un autre domaine que l'API
APP_ORIGIN=
# Dossier de l'application compilée à servir (vide = API seule)
STATIC_DIR=
LOG_LEVEL=info

# ---- E-mails (récupération du mot de passe) ----
# Adresse publique de l'application, utilisée dans les liens envoyés
APP_URL=https://ton-domaine.fr
# Serveur d'envoi (ex. smtps://utilisateur:motdepasse@smtp.exemple.fr:465). Vide : e-mails écrits dans le journal.
SMTP_URL=
MAIL_FROM=Pousse <no-reply@ton-domaine.fr>

# ---- Rappel du soir (notifications push) ----
# Générer une paire de clés une seule fois : npx web-push generate-vapid-keys
# (ne jamais changer la clé privée ensuite : les abonnements existants deviendraient invalides)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ton-domaine.fr
