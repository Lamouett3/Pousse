  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.3.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.13.3",
    "web-push": "^3.6.7"
  }
}
