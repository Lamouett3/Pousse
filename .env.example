# Application (Vite). Racine de l'API de sauvegarde en ligne.
# Vide ou absent : application 100 % locale (comportement d'origine).
VITE_API_URL=/api

# ---- Rappel du soir (notifications push), facultatif ----
# Générer une paire de clés une seule fois : npx web-push generate-vapid-keys
# Ne plus jamais changer la clé privée ensuite (les rappels existants cesseraient de fonctionner).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ton-domaine.fr
