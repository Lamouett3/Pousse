{
  "name": "pousse-api",
  "version": "1.0.0",
  "private": true,
  "description": "API et base de données de Pousse : comptes, sessions et synchronisation des données de santé",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
